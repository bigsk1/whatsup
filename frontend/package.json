{
  "name": "whatsup-frontend",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "preview": "vite preview --host 127.0.0.2",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit --project tsconfig.node.json",
    "format:check": "prettier --check src tests *.ts *.js *.json index.html",
    "format": "prettier --write src tests *.ts *.js *.json index.html",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:bundle": "playwright test --config playwright.bundle.config.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@wailsio/runtime": "3.1.0",
    "phosphor-svelte": "3.1.1",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
