+//go:build windows
+
+package application
+
+import (
+	"testing"
+
+	"github.com/wailsapp/wails/v3/internal/webview2/pkg/edge"
+)
+
+func TestWhatsUpPermissionAnswersReadTheApplicationsLiveTable(t *testing.T) {
+	const microphone = edge.CoreWebView2PermissionKind(CoreWebView2PermissionKindMicrophone)
+	const camera = edge.CoreWebView2PermissionKind(CoreWebView2PermissionKindCamera)
+	const sensors = edge.CoreWebView2PermissionKind(CoreWebView2PermissionKindOtherSensors)
+	general := map[PermissionType]Permission{PermissionMicrophone: PermissionDeny, PermissionCamera: PermissionDeny}
+	specific := map[CoreWebView2PermissionKind]CoreWebView2PermissionState{CoreWebView2PermissionKindOtherSensors: CoreWebView2PermissionStateDeny}
+	answer := func(kind edge.CoreWebView2PermissionKind) (edge.CoreWebView2PermissionState, bool) {
+		return whatsupPermissionAnswer(kind, specific, general)
+	}
+	if state, ok := answer(microphone); !ok || state != edge.CoreWebView2PermissionStateDeny {
+		t.Fatalf("idle microphone: %v %v", state, ok)
+	}
+	// The application changes its own map; no call into the window is needed.
+	general[PermissionMicrophone] = PermissionAllow
+	if state, ok := answer(microphone); !ok || state != edge.CoreWebView2PermissionStateAllow {
+		t.Fatalf("microphone during a call: %v %v", state, ok)
+	}
+	if state, ok := answer(camera); !ok || state != edge.CoreWebView2PermissionStateDeny {
+		t.Fatalf("camera stays denied while the microphone is allowed: %v %v", state, ok)
+	}
+	general[PermissionMicrophone] = PermissionDeny
+	if state, _ := answer(microphone); state != edge.CoreWebView2PermissionStateDeny {
+		t.Fatalf("microphone after the call: %v", state)
+	}
+	// The Windows-specific table wins over the general one.
+	if state, ok := answer(sensors); !ok || state != edge.CoreWebView2PermissionStateDeny {
+		t.Fatalf("Windows-only kind: %v %v", state, ok)
+	}
+	specific[CoreWebView2PermissionKindMicrophone] = CoreWebView2PermissionStateDeny
+	general[PermissionMicrophone] = PermissionAllow
+	if state, _ := answer(microphone); state != edge.CoreWebView2PermissionStateDeny {
+		t.Fatalf("the Windows-specific deny did not win: %v", state)
+	}
+	// A kind in neither table has no answer, which the handler denies.
+	if _, ok := answer(edge.CoreWebView2PermissionKind(CoreWebView2PermissionKindGeolocation)); ok {
+		t.Fatal("an unlisted kind was given an answer")
+	}
+	if _, ok := answer(edge.CoreWebView2PermissionKind(CoreWebView2PermissionKindUnknownPermission)); ok {
+		t.Fatal("the unknown kind matched a table entry")
+	}
+	if len(whatsupPermissionKinds) != 6 {
+		t.Fatalf("%d permission kinds are erased at start, want all 6", len(whatsupPermissionKinds))
+	}
+}
