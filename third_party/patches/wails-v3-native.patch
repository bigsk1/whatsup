+//go:build windows
+
+package edge
+
+import (
+	"errors"
+	"runtime"
+	"sync"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// WhatsUp: permission decisions that last exactly as long as the reason for
+// them.
+//
+// WebView2 saves the answer to a permission request in the profile by default.
+// After one Allow it stops raising PermissionRequested for that origin and
+// kind, in this session and later ones, so the page could open the microphone
+// whenever it liked. A messenger must allow capture only during an answered
+// call. With a PermissionSource set, every request is therefore:
+//
+//   - answered from the source at that moment, Allow or Deny, never WebView2's
+//     own prompt;
+//   - marked not to be saved (ICoreWebView2PermissionRequestedEventArgs3), so
+//     the next request raises the event again;
+//   - denied outright when the runtime is too old to keep an answer out of the
+//     profile, because an Allow that cannot be kept temporary is not given.
+//
+// ForgetSavedPermissions erases answers a previous build or an older runtime
+// already saved (ICoreWebView2Profile4). A saved Allow is honoured by WebView2
+// without raising the request event at all, so until the runtime has confirmed
+// that erasure nothing here can refuse it. PermissionsSecured records that
+// confirmation: without it every request that does arrive is denied, and the
+// window does not load the page before the answer is known.
+
+// Vtable slots of the interface methods used here. Each count starts after
+// IUnknown's three and includes every inherited interface.
+const (
+	whatsupArgs3PutSavesInProfile  = 12  // EventArgs 3..8, EventArgs2 9..10, EventArgs3 11..12
+	whatsupWebView13GetProfile     = 105 // ICoreWebView2 through ICoreWebView2_12 end at 104
+	whatsupProfile4SetPermission   = 15  // Profile 3..9, Profile2 10..12, Profile3 13..14
+	whatsupUnknownQueryInterface   = 0
+	whatsupUnknownRelease          = 2
+	whatsupIIDPermissionArgs3      = "{e61670bc-3dce-4177-86d2-c629ae3cb6ac}"
+	whatsupIIDWebView13            = "{f75f09a8-667e-4983-88d6-c8773f315e84}"
+	whatsupIIDProfile4             = "{8f4ae680-192e-4ec8-833a-21cfadaef628}"
+	whatsupHRESULTNoInterface      = 0x80004002
+	whatsupPermissionVtableCeiling = 128
+)
+
+// whatsupCOM is any COM object, addressed by vtable slot.
+type whatsupCOM struct {
+	vtbl *[whatsupPermissionVtableCeiling]ComProc
+}
+
+func whatsupQuery(object unsafe.Pointer, iid string) *whatsupCOM {
+	if object == nil {
+		return nil
+	}
+	source := (*whatsupCOM)(object)
+	if source.vtbl == nil || source.vtbl[whatsupUnknownQueryInterface] == 0 {
+		return nil
+	}
+	var result *whatsupCOM
+	hr, _, _ := source.vtbl[whatsupUnknownQueryInterface].Call(
+		uintptr(object),
+		uintptr(unsafe.Pointer(NewGUID(iid))),
+		uintptr(unsafe.Pointer(&result)),
+	)
+	if int32(hr) < 0 {
+		return nil
+	}
+	return result
+}
+
+func (c *whatsupCOM) release() {
+	if c != nil && c.vtbl != nil && c.vtbl[whatsupUnknownRelease] != 0 {
+		_, _, _ = c.vtbl[whatsupUnknownRelease].Call(uintptr(unsafe.Pointer(c)))
+	}
+}
+
+// whatsupKeepOutOfProfile asks WebView2 not to save this request's answer. It
+// reports whether the runtime accepted that.
+func (i *iCoreWebView2PermissionRequestedEventArgs) whatsupKeepOutOfProfile() bool {
+	args3 := whatsupQuery(unsafe.Pointer(i), whatsupIIDPermissionArgs3)
+	if args3 == nil {
+		return false
+	}
+	defer args3.release()
+	hr, _, _ := args3.vtbl[whatsupArgs3PutSavesInProfile].Call(uintptr(unsafe.Pointer(args3)), 0)
+	return int32(hr) >= 0
+}
+
+func (e *Chromium) whatsupPermissionRequested(args *iCoreWebView2PermissionRequestedEventArgs) uintptr {
+	result := CoreWebView2PermissionStateDeny
+	if kind, err := args.GetPermissionKind(); err == nil && e.PermissionsSecured {
+		if state, ok := e.PermissionSource(kind); ok && state == CoreWebView2PermissionStateAllow {
+			result = CoreWebView2PermissionStateAllow
+		}
+	}
+	// Even a Deny is kept out of the profile where possible: a saved Deny
+	// would silence the event and refuse the next answered call.
+	if !args.whatsupKeepOutOfProfile() {
+		result = CoreWebView2PermissionStateDeny
+	}
+	// On failure WebView2 applies its default handling to this one request.
+	_ = args.PutState(result)
+	return 0
+}
+
+// whatsupPermissionReset is one ForgetSavedPermissions request: a COM
+// completion handler shared by every kind it erases. It reports once, when
+// the runtime has answered for all of them.
+type whatsupPermissionReset struct {
+	vtbl      *whatsupPermissionResetVtbl
+	remaining int
+	failed    bool
+	done      func(erased bool)
+}
+
+type whatsupPermissionResetVtbl struct {
+	_IUnknownVtbl
+	Invoke ComProc
+}
+
+// Requests still waiting for the runtime. The map keeps each handler reachable
+// while only WebView2 holds a pointer to it.
+var whatsupPermissionResets = struct {
+	sync.Mutex
+	pending map[*whatsupPermissionReset]struct{}
+}{pending: map[*whatsupPermissionReset]struct{}{}}
+
+func whatsupPermissionResetQueryInterface(this *whatsupPermissionReset, _ uintptr, object *unsafe.Pointer) uintptr {
+	if object == nil {
+		return whatsupHRESULTNoInterface
+	}
+	// One interface besides IUnknown: either is this object.
+	*object = unsafe.Pointer(this)
+	return 0
+}
+
+// The pending map, not a COM count, decides the handler's lifetime.
+func whatsupPermissionResetAddRef(*whatsupPermissionReset) uintptr  { return 2 }
+func whatsupPermissionResetRelease(*whatsupPermissionReset) uintptr { return 1 }
+
+func whatsupPermissionResetInvoke(this *whatsupPermissionReset, errorCode uintptr) uintptr {
+	this.settle(int32(errorCode) >= 0)
+	return 0
+}
+
+// settle records one kind's result. WebView2 calls back on the thread that
+// made the request, which is also where ForgetSavedPermissions runs.
+func (r *whatsupPermissionReset) settle(ok bool) {
+	if r.remaining <= 0 {
+		return
+	}
+	if !ok {
+		r.failed = true
+	}
+	r.remaining--
+	if r.remaining > 0 {
+		return
+	}
+	whatsupPermissionResets.Lock()
+	delete(whatsupPermissionResets.pending, r)
+	whatsupPermissionResets.Unlock()
+	if done := r.done; done != nil {
+		r.done = nil
+		done(!r.failed)
+	}
+}
+
+var whatsupPermissionResetFn = whatsupPermissionResetVtbl{
+	_IUnknownVtbl{
+		NewComProc(whatsupPermissionResetQueryInterface),
+		NewComProc(whatsupPermissionResetAddRef),
+		NewComProc(whatsupPermissionResetRelease),
+	},
+	NewComProc(whatsupPermissionResetInvoke),
+}
+
+// ForgetSavedPermissions erases any answer saved in this webview's profile for
+// the origin and each kind, restoring the default so that the next request
+// raises PermissionRequested again.
+//
+// The erasure is asynchronous. done is called exactly once, on this thread,
+// when the runtime has answered for every kind: true only if every erasure
+// succeeded. When an error is returned nothing was requested and done is never
+// called; UnsupportedCapabilityError means the runtime has no permission
+// management. Either way the caller must treat saved answers as still present.
+func (e *Chromium) ForgetSavedPermissions(origin string, done func(erased bool), kinds ...CoreWebView2PermissionKind) error {
+	if e.webview == nil {
+		return errors.New("webview2 is not initialized")
+	}
+	if done == nil || len(kinds) == 0 {
+		return errors.New("a completion callback and at least one permission kind are required")
+	}
+	text, err := windows.UTF16PtrFromString(origin)
+	if err != nil {
+		return err
+	}
+	webview13 := whatsupQuery(unsafe.Pointer(e.webview), whatsupIIDWebView13)
+	if webview13 == nil {
+		return UnsupportedCapabilityError
+	}
+	defer webview13.release()
+	var profile *whatsupCOM
+	hr, _, _ := webview13.vtbl[whatsupWebView13GetProfile].Call(
+		uintptr(unsafe.Pointer(webview13)),
+		uintptr(unsafe.Pointer(&profile)),
+	)
+	if int32(hr) < 0 || profile == nil {
+		return UnsupportedCapabilityError
+	}
+	defer profile.release()
+	profile4 := whatsupQuery(unsafe.Pointer(profile), whatsupIIDProfile4)
+	if profile4 == nil {
+		return UnsupportedCapabilityError
+	}
+	defer profile4.release()
+
+	reset := &whatsupPermissionReset{vtbl: &whatsupPermissionResetFn, remaining: len(kinds), done: done}
+	whatsupPermissionResets.Lock()
+	whatsupPermissionResets.pending[reset] = struct{}{}
+	whatsupPermissionResets.Unlock()
+	refused := 0
+	for _, kind := range kinds {
+		hr, _, _ := profile4.vtbl[whatsupProfile4SetPermission].Call(
+			uintptr(unsafe.Pointer(profile4)),
+			uintptr(kind),
+			uintptr(unsafe.Pointer(text)),
+			uintptr(CoreWebView2PermissionStateDefault),
+			uintptr(unsafe.Pointer(reset)),
+		)
+		if int32(hr) < 0 {
+			// No completion will arrive for a request the runtime refused.
+			refused++
+		}
+	}
+	runtime.KeepAlive(text)
+	for ; refused > 0; refused-- {
+		reset.settle(false)
+	}
+	return nil
+}
