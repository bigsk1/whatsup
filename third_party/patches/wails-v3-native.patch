+package application
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+// WhatsUpPatchVersion identifies the reviewed, application-private native patch.
+const WhatsUpPatchVersion = 1
+
+// ServeCompletedReader takes ownership of reader, including on error. The reader
+// must contain immutable, complete content; it must not wait for a producer.
+// Callers must set a trusted Content-Type and their own security headers first.
+// GET, HEAD and a single byte range are supported. The handler goroutine remains
+// alive until native consumption ends, so its request cancellation stays valid.
+func ServeCompletedReader(w http.ResponseWriter, r *http.Request, reader io.ReadSeekCloser, length int64) error {
+	if reader == nil {
+		return errors.New("completed reader is nil")
+	}
+	owned := &completedReader{reader: reader}
+	defer owned.Close()
+	if w == nil || r == nil || length < 0 || w.Header().Get("Content-Type") == "" {
+		return errors.New("invalid completed response")
+	}
+	if err := r.Context().Err(); err != nil {
+		return err
+	}
+	if r.Method != http.MethodGet && r.Method != http.MethodHead {
+		w.Header().Set("Allow", "GET, HEAD")
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		return nil
+	}
+	start, count, partial, ok := completedRange(r, length)
+	if !ok {
+		w.Header().Set("Content-Range", "bytes */"+strconv.FormatInt(length, 10))
+		w.Header().Set("Content-Length", "0")
+		w.WriteHeader(http.StatusRequestedRangeNotSatisfiable)
+		return nil
+	}
+	w.Header().Set("Accept-Ranges", "bytes")
+	w.Header().Set("Content-Length", strconv.FormatInt(count, 10))
+	code := http.StatusOK
+	if partial {
+		code = http.StatusPartialContent
+		w.Header().Set("Content-Range", "bytes "+strconv.FormatInt(start, 10)+"-"+strconv.FormatInt(start+count-1, 10)+"/"+strconv.FormatInt(length, 10))
+	}
+	if r.Method == http.MethodHead || count == 0 {
+		w.WriteHeader(code)
+		return nil
+	}
+	if _, err := owned.Seek(start, io.SeekStart); err != nil {
+		return err
+	}
+	section := &completedSection{reader: owned, start: start, length: count}
+	// Discover the native capability before committing the outer wrappers. Never
+	// bypass their header propagation or content-type bookkeeping.
+	var native interface {
+		SetCompletedReader(context.Context, io.ReadSeekCloser, int64) error
+	}
+	current := w
+	for depth := 0; depth < 16; depth++ {
+		if candidate, ok := current.(interface {
+			SetCompletedReader(context.Context, io.ReadSeekCloser, int64) error
+		}); ok {
+			native = candidate
+			break
+		}
+		u, ok := current.(interface{ Unwrap() http.ResponseWriter })
+		if !ok {
+			break
+		}
+		next := u.Unwrap()
+		if next == nil || next == current {
+			break
+		}
+		current = next
+	}
+	w.WriteHeader(code)
+	if native != nil {
+		return native.SetCompletedReader(r.Context(), section, count)
+	}
+	stop := context.AfterFunc(r.Context(), func() { _ = owned.Close() })
+	defer stop()
+	written, err := io.CopyBuffer(w, section, make([]byte, 64<<10))
+	if err == nil && written != count {
+		return io.ErrUnexpectedEOF
+	}
+	return err
+}
+
+func completedRange(r *http.Request, size int64) (start, count int64, partial, ok bool) {
+	value := r.Header.Get("Range")
+	if value == "" || r.Method != http.MethodGet || r.Header.Get("If-Range") != "" {
+		return 0, size, false, true
+	}
+	if !strings.HasPrefix(value, "bytes=") || strings.Contains(value, ",") || size == 0 {
+		return 0, 0, false, false
+	}
+	left, right, found := strings.Cut(strings.TrimPrefix(value, "bytes="), "-")
+	if !found {
+		return 0, 0, false, false
+	}
+	parse := func(s string) (int64, bool) {
+		if s == "" {
+			return 0, false
+		}
+		for _, c := range s {
+			if c < '0' || c > '9' {
+				return 0, false
+			}
+		}
+		n, err := strconv.ParseInt(s, 10, 64)
+		return n, err == nil
+	}
+	if left == "" {
+		n, valid := parse(right)
+		if !valid || n <= 0 {
+			return 0, 0, false, false
+		}
+		if n > size {
+			n = size
+		}
+		return size - n, n, true, true
+	}
+	first, valid := parse(left)
+	if !valid || first >= size {
+		return 0, 0, false, false
+	}
+	last := size - 1
+	if right != "" {
+		n, valid := parse(right)
+		if !valid || n < first {
+			return 0, 0, false, false
+		}
+		if n < last {
+			last = n
+		}
+	}
+	return first, last - first + 1, true, true
+}
+
+type completedReader struct {
+	mu     sync.Mutex
+	reader io.ReadSeekCloser
+	closed bool
+}
+
+func (r *completedReader) Read(p []byte) (int, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return 0, io.ErrClosedPipe
+	}
+	return r.reader.Read(p)
+}
+func (r *completedReader) Seek(n int64, whence int) (int64, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return 0, io.ErrClosedPipe
+	}
+	return r.reader.Seek(n, whence)
+}
+func (r *completedReader) Close() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed {
+		return nil
+	}
+	r.closed = true
+	return r.reader.Close()
+}
+
+type completedSection struct {
+	reader                  *completedReader
+	start, length, position int64
+}
+
+func (s *completedSection) Read(p []byte) (int, error) {
+	if s.position >= s.length {
+		return 0, io.EOF
+	}
+	if int64(len(p)) > s.length-s.position {
+		p = p[:s.length-s.position]
+	}
+	n, err := s.reader.Read(p)
+	s.position += int64(n)
+	return n, err
+}
+func (s *completedSection) Seek(n int64, whence int) (int64, error) {
+	switch whence {
+	case io.SeekCurrent:
+		n += s.position
+	case io.SeekEnd:
+		n += s.length
+	case io.SeekStart:
+	default:
+		return 0, errors.New("invalid completed seek")
+	}
+	if n < 0 || n > s.length {
+		return 0, errors.New("completed seek out of bounds")
+	}
+	if _, err := s.reader.Seek(s.start+n, io.SeekStart); err != nil {
+		return 0, err
+	}
+	s.position = n
+	return n, nil
+}
+func (s *completedSection) Close() error { return s.reader.Close() }
