+type whatsUpStreamReader struct {
+	*bytes.Reader
+	closes, maximum int
+}
+
+func TestWhatsUpReaderMarshalsFromSTAIntoBackgroundMTA(t *testing.T) {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	ole := windows.NewLazySystemDLL("ole32.dll")
+	hr, _, _ := ole.NewProc("CoInitializeEx").Call(0, 2)
+	if int32(hr) < 0 {
+		t.Fatal("STA initialization failed")
+	}
+	defer ole.NewProc("CoUninitialize").Call()
+	r := &whatsUpStreamReader{Reader: bytes.NewReader([]byte("synthetic native stream"))}
+	stream, err := NewReaderStream(r, 23)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stream.Release()
+	var marshaled uintptr
+	hr, _, _ = ole.NewProc("CoMarshalInterThreadInterfaceInStream").Call(uintptr(unsafe.Pointer(&readerIStream)), uintptr(unsafe.Pointer(stream.IStream())), uintptr(unsafe.Pointer(&marshaled)))
+	if int32(hr) < 0 || marshaled == 0 {
+		t.Fatal("stream could not be marshaled")
+	}
+	done := make(chan error, 1)
+	go func() {
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		result, _, _ := ole.NewProc("CoInitializeEx").Call(0, 0)
+		if int32(result) < 0 {
+			done <- io.ErrClosedPipe
+			return
+		}
+		defer ole.NewProc("CoUninitialize").Call()
+		var pointer uintptr
+		result, _, _ = ole.NewProc("CoGetInterfaceAndReleaseStream").Call(marshaled, uintptr(unsafe.Pointer(&readerIStream)), uintptr(unsafe.Pointer(&pointer)))
+		if int32(result) < 0 || pointer == 0 {
+			done <- io.ErrClosedPipe
+			return
+		}
+		native := (*IStream)(unsafe.Pointer(pointer))
+		defer native.Release()
+		bytes := make([]byte, 23)
+		n, err := native.Read(bytes)
+		if err == nil && (n != 23 || string(bytes) != "synthetic native stream") {
+			err = io.ErrUnexpectedEOF
+		}
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("background native read blocked")
+	}
+}
+
+func TestWhatsUpReaderPrematureEOFIsFailureAndCloses(t *testing.T) {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	ole := windows.NewLazySystemDLL("ole32.dll")
+	hr, _, _ := ole.NewProc("CoInitializeEx").Call(0, 0)
+	if int32(hr) < 0 {
+		t.Fatal("COM initialization failed")
+	}
+	defer ole.NewProc("CoUninitialize").Call()
+	r := &whatsUpStreamReader{Reader: bytes.NewReader([]byte("x"))}
+	stream, err := NewReaderStream(r, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stream.Release()
+	_, err = stream.IStream().Read(make([]byte, 3))
+	if err == nil || err == io.EOF || stream.Err() == nil || r.closes != 1 {
+		t.Fatalf("truncated content accepted: %v closes=%d", err, r.closes)
+	}
+}
+
+func (r *whatsUpStreamReader) Read(p []byte) (int, error) {
+	if len(p) > r.maximum {
+		r.maximum = len(p)
+	}
+	return r.Reader.Read(p)
+}
+func (r *whatsUpStreamReader) Close() error { r.closes++; return nil }
+func TestWhatsUpReaderNativeCOMReadSeekStatAndLifetime(t *testing.T) {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	ole := windows.NewLazySystemDLL("ole32.dll")
+	hr, _, _ := ole.NewProc("CoInitializeEx").Call(0, 0)
+	if int32(hr) < 0 {
+		t.Fatal("COM initialization failed")
+	}
+	defer ole.NewProc("CoUninitialize").Call()
+	body := bytes.Repeat([]byte("01234567"), 20000)
+	r := &whatsUpStreamReader{Reader: bytes.NewReader(body)}
+	stream, err := NewReaderStream(r, int64(len(body)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	native := stream.IStream()
+	data := make([]byte, len(body)+1)
+	n, err := native.Read(data)
+	if n != len(body) || err != io.EOF || !bytes.Equal(data[:n], body) || r.maximum > 64<<10 {
+		t.Fatalf("native read n=%d err=%v maximum=%d", n, err, r.maximum)
+	}
+	var position uint64
+	hr, _, _ = syscall.SyscallN(readerStreamVTable[5], uintptr(unsafe.Pointer(stream.native)), 3, 0, uintptr(unsafe.Pointer(&position)))
+	if hr != 0 || position != 3 {
+		t.Fatalf("seek=%x/%d", hr, position)
+	}
+	n, err = native.Read(data[:4])
+	if n != 4 || err != nil || string(data[:4]) != "3456" {
+		t.Fatal("seek/read mismatch")
+	}
+	var stat readerStatSTG
+	hr, _, _ = syscall.SyscallN(readerStreamVTable[12], uintptr(unsafe.Pointer(stream.native)), uintptr(unsafe.Pointer(&stat)), 1)
+	if hr != 0 || stat.Size != uint64(len(body)) || stat.Type != 2 || unsafe.Sizeof(stat) != 80 {
+		t.Fatal("native STATSTG layout/length")
+	}
+	var marshal uintptr
+	hr = readerQueryInterface(uintptr(unsafe.Pointer(stream.native)), uintptr(unsafe.Pointer(&readerIMarshal)), uintptr(unsafe.Pointer(&marshal)))
+	if hr != 0 || marshal == 0 {
+		t.Fatal("free-threaded marshaler missing")
+	}
+	vtable := *(*[3]uintptr)(unsafe.Pointer(*(*uintptr)(unsafe.Pointer(marshal))))
+	_, _, _ = syscall.SyscallN(vtable[2], marshal)
+	stream.Release()
+	select {
+	case <-stream.Done():
+	default:
+		t.Fatal("native release did not close reader")
+	}
+	if r.closes != 1 {
+		t.Fatalf("reader closed %d times", r.closes)
+	}
+	_ = stream.Close()
+	if r.closes != 1 {
+		t.Fatal("close not idempotent")
+	}
+}
