+func TestWhatsUpNativeReaderAndStrictDropStartup(t *testing.T) {
+	if os.Getenv("WHATSUP_NATIVE_WAILS") != "1" {
+		t.Skip("set WHATSUP_NATIVE_WAILS=1 in a native Windows desktop session")
+	}
+	root, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for {
+		data, _ := os.ReadFile(filepath.Join(root, "go.mod"))
+		if strings.HasPrefix(string(data), "module whatsup\n") {
+			break
+		}
+		parent := filepath.Dir(root)
+		if parent == root {
+			t.Fatal("authoritative frozen graph not found")
+		}
+		root = parent
+	}
+	directory, err := os.MkdirTemp(filepath.Join(root, ".local"), "wails-native-qa-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
+	defer cancel()
+	binary := filepath.Join(directory, "native.exe")
+	command := exec.CommandContext(ctx, filepath.Join(runtime.GOROOT(), "bin/go.exe"), "build", "-mod=readonly", "-o", binary, "github.com/wailsapp/wails/v3/pkg/application/testdata/whatsup-native")
+	command.Dir = root
+	command.Env = append(os.Environ(), "GOTOOLCHAIN=local", "GOWORK=off", "CGO_ENABLED=0")
+	if output, err := command.CombinedOutput(); err != nil {
+		t.Fatalf("native probe build failed: %v\n%s", err, output)
+	}
+	command = exec.CommandContext(ctx, binary)
+	command.Dir = directory
+	output, err := command.CombinedOutput()
+	if err != nil {
+		t.Fatalf("native probe failed: %v\n%s", err, output)
+	}
+	if !strings.Contains(string(output), `"nativeReaderRanges":true`) {
+		t.Fatal("native probe result absent")
+	}
+	t.Log(strings.TrimSpace(string(output)))
+}
