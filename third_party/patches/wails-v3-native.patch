+//go:build windows
+
+package edge
+
+import (
+	"errors"
+	"testing"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Fake COM objects, addressed by slot exactly as the code under test does.
+// No WebView2 runtime is involved.
+
+type whatsupFakeCOM struct {
+	vtbl *[whatsupPermissionVtableCeiling]ComProc
+}
+
+func whatsupFake(slots map[int]ComProc) *whatsupFakeCOM {
+	table := &[whatsupPermissionVtableCeiling]ComProc{}
+	table[whatsupUnknownRelease] = NewComProc(func(uintptr) uintptr { return 0 })
+	for slot, proc := range slots {
+		table[slot] = proc
+	}
+	return &whatsupFakeCOM{vtbl: table}
+}
+
+// whatsupFakeArgs builds permission request arguments. savesHR is what
+// put_SavesInProfile returns; args3 false means the runtime has no
+// ICoreWebView2PermissionRequestedEventArgs3.
+func whatsupFakeArgs(t *testing.T, kind CoreWebView2PermissionKind, kindHR uintptr, args3 bool, savesHR uintptr) (args *iCoreWebView2PermissionRequestedEventArgs, put *[]CoreWebView2PermissionState, saves *[]uintptr) {
+	t.Helper()
+	put, saves = &[]CoreWebView2PermissionState{}, &[]uintptr{}
+	third := whatsupFake(map[int]ComProc{
+		whatsupArgs3PutSavesInProfile: NewComProc(func(_ uintptr, value uintptr) uintptr {
+			*saves = append(*saves, value)
+			return savesHR
+		}),
+	})
+	args = &iCoreWebView2PermissionRequestedEventArgs{vtbl: &iCoreWebView2PermissionRequestedEventArgsVtbl{
+		_IUnknownVtbl: _IUnknownVtbl{
+			QueryInterface: NewComProc(func(_ uintptr, iid *GUID, object *unsafe.Pointer) uintptr {
+				if !args3 || *iid != *NewGUID(whatsupIIDPermissionArgs3) {
+					return whatsupHRESULTNoInterface
+				}
+				*object = unsafe.Pointer(third)
+				return 0
+			}),
+		},
+		GetPermissionKind: NewComProc(func(_ uintptr, out *CoreWebView2PermissionKind) uintptr {
+			*out = kind
+			return kindHR
+		}),
+		PutState: NewComProc(func(_ uintptr, state uintptr) uintptr {
+			*put = append(*put, CoreWebView2PermissionState(state))
+			return 0
+		}),
+	}}
+	return args, put, saves
+}
+
+func TestWhatsUpPermissionRequestsAreAnsweredLiveAndNeverSaved(t *testing.T) {
+	const microphone, camera = CoreWebView2PermissionKind(1), CoreWebView2PermissionKind(2)
+	const failure = uintptr(0x80004005)
+	table := map[CoreWebView2PermissionKind]CoreWebView2PermissionState{microphone: CoreWebView2PermissionStateDeny}
+	asked := 0
+	e := &Chromium{PermissionsSecured: true, PermissionSource: func(kind CoreWebView2PermissionKind) (CoreWebView2PermissionState, bool) {
+		asked++
+		state, ok := table[kind]
+		return state, ok
+	}}
+	request := func(kind CoreWebView2PermissionKind, kindHR uintptr, args3 bool, savesHR uintptr) (CoreWebView2PermissionState, []uintptr) {
+		t.Helper()
+		args, put, saves := whatsupFakeArgs(t, kind, kindHR, args3, savesHR)
+		if e.PermissionRequested(nil, args) != 0 {
+			t.Fatal("the handler reported a failure to WebView2")
+		}
+		if len(*put) != 1 {
+			t.Fatalf("PutState was called %d times, want once", len(*put))
+		}
+		return (*put)[0], *saves
+	}
+
+	// Outside a call the table says deny.
+	if state, saves := request(microphone, 0, true, 0); state != CoreWebView2PermissionStateDeny || len(saves) != 1 || saves[0] != 0 {
+		t.Fatalf("idle microphone request: state %v, SavesInProfile calls %v; want Deny and one FALSE", state, saves)
+	}
+	// The application flips the entry for an answered call. The very next
+	// request sees it: the table is read at request time, not copied.
+	table[microphone] = CoreWebView2PermissionStateAllow
+	if state, saves := request(microphone, 0, true, 0); state != CoreWebView2PermissionStateAllow || len(saves) != 1 || saves[0] != 0 {
+		t.Fatalf("in-call microphone request: state %v, SavesInProfile calls %v; want Allow and one FALSE", state, saves)
+	}
+	// And the call ends.
+	table[microphone] = CoreWebView2PermissionStateDeny
+	if state, _ := request(microphone, 0, true, 0); state != CoreWebView2PermissionStateDeny {
+		t.Fatalf("microphone request after the call: state %v, want Deny", state)
+	}
+	if asked != 3 {
+		t.Fatalf("the source was consulted %d times for 3 requests", asked)
+	}
+
+	// A kind the table does not mention, and one marked default, are denied:
+	// the runtime prompt, whose answer it would save, is never shown.
+	if state, _ := request(camera, 0, true, 0); state != CoreWebView2PermissionStateDeny {
+		t.Fatalf("unlisted kind: state %v, want Deny", state)
+	}
+	table[camera] = CoreWebView2PermissionStateDefault
+	if state, _ := request(camera, 0, true, 0); state != CoreWebView2PermissionStateDeny {
+		t.Fatalf("default kind: state %v, want Deny", state)
+	}
+
+	// An Allow that cannot be kept out of the profile is not given.
+	table[microphone] = CoreWebView2PermissionStateAllow
+	if state, saves := request(microphone, 0, false, 0); state != CoreWebView2PermissionStateDeny || len(saves) != 0 {
+		t.Fatalf("runtime without EventArgs3: state %v, SavesInProfile calls %v; want Deny and none", state, saves)
+	}
+	if state, _ := request(microphone, 0, true, failure); state != CoreWebView2PermissionStateDeny {
+		t.Fatalf("put_SavesInProfile failed: state %v, want Deny", state)
+	}
+	// A request whose kind cannot be read is denied.
+	if state, _ := request(microphone, failure, true, 0); state != CoreWebView2PermissionStateDeny {
+		t.Fatalf("unreadable kind: state %v, want Deny", state)
+	}
+
+	// Until the runtime has confirmed that saved answers are erased, the
+	// source is not even consulted: the table saying allow is not enough.
+	e.PermissionsSecured = false
+	before := asked
+	if state, saves := request(microphone, 0, true, 0); state != CoreWebView2PermissionStateDeny || len(saves) != 1 || saves[0] != 0 {
+		t.Fatalf("unsecured profile: state %v, SavesInProfile calls %v; want Deny and one FALSE", state, saves)
+	}
+	if asked != before {
+		t.Fatal("the source was consulted before saved answers were confirmed erased")
+	}
+}
+
+func TestWhatsUpWithoutAPermissionSourceTheOriginalHandlerIsUnchanged(t *testing.T) {
+	// No QueryInterface on these arguments: the original path must not need it.
+	var got []CoreWebView2PermissionState
+	args := &iCoreWebView2PermissionRequestedEventArgs{vtbl: &iCoreWebView2PermissionRequestedEventArgsVtbl{
+		GetPermissionKind: NewComProc(func(_ uintptr, out *CoreWebView2PermissionKind) uintptr { *out = 1; return 0 }),
+		PutState: NewComProc(func(_ uintptr, state uintptr) uintptr {
+			got = append(got, CoreWebView2PermissionState(state))
+			return 0
+		}),
+	}}
+	e := &Chromium{permissions: map[CoreWebView2PermissionKind]CoreWebView2PermissionState{1: CoreWebView2PermissionStateAllow}}
+	e.PermissionRequested(nil, args)
+	if len(got) != 1 || got[0] != CoreWebView2PermissionStateAllow {
+		t.Fatalf("original handler answered %v, want one Allow from the copied table", got)
+	}
+}
+
+func TestWhatsUpForgetSavedPermissionsReportsOnceWhenTheRuntimeHasAnsweredForEveryKind(t *testing.T) {
+	type erased struct {
+		kind   CoreWebView2PermissionKind
+		origin string
+		state  CoreWebView2PermissionState
+	}
+	var calls []erased
+	var handlers []*whatsupPermissionReset
+	// refuse lists the kinds whose request the runtime rejects at once.
+	build := func(webview13, profile4 bool, refuse map[CoreWebView2PermissionKind]bool) *Chromium {
+		fourth := whatsupFake(map[int]ComProc{
+			whatsupProfile4SetPermission: NewComProc(func(_ uintptr, kind uintptr, origin *uint16, state uintptr, handler *whatsupPermissionReset) uintptr {
+				calls = append(calls, erased{CoreWebView2PermissionKind(kind), windows.UTF16PtrToString(origin), CoreWebView2PermissionState(state)})
+				if refuse[CoreWebView2PermissionKind(kind)] {
+					return 0x80070057
+				}
+				handlers = append(handlers, handler)
+				return 0
+			}),
+		})
+		profile := whatsupFake(map[int]ComProc{
+			whatsupUnknownQueryInterface: NewComProc(func(_ uintptr, iid *GUID, object *unsafe.Pointer) uintptr {
+				if !profile4 || *iid != *NewGUID(whatsupIIDProfile4) {
+					return whatsupHRESULTNoInterface
+				}
+				*object = unsafe.Pointer(fourth)
+				return 0
+			}),
+		})
+		thirteenth := whatsupFake(map[int]ComProc{
+			whatsupWebView13GetProfile: NewComProc(func(_ uintptr, out *unsafe.Pointer) uintptr {
+				*out = unsafe.Pointer(profile)
+				return 0
+			}),
+		})
+		return &Chromium{webview: &ICoreWebView2{vtbl: &iCoreWebView2Vtbl{_IUnknownVtbl: _IUnknownVtbl{
+			QueryInterface: NewComProc(func(_ uintptr, iid *GUID, object *unsafe.Pointer) uintptr {
+				if !webview13 || *iid != *NewGUID(whatsupIIDWebView13) {
+					return whatsupHRESULTNoInterface
+				}
+				*object = unsafe.Pointer(thirteenth)
+				return 0
+			}),
+		}}}}
+	}
+	// complete delivers the asynchronous answer for one request, through the
+	// COM vtable exactly as WebView2 would.
+	complete := func(handler *whatsupPermissionReset, hr uintptr) {
+		handler.vtbl.Invoke.Call(uintptr(unsafe.Pointer(handler)), hr)
+	}
+	pending := func() int {
+		whatsupPermissionResets.Lock()
+		defer whatsupPermissionResets.Unlock()
+		return len(whatsupPermissionResets.pending)
+	}
+	const origin = "http://wails.localhost"
+
+	// Every kind erased: nothing is reported until the last answer arrives.
+	var reports []bool
+	report := func(erased bool) { reports = append(reports, erased) }
+	if err := build(true, true, nil).ForgetSavedPermissions(origin, report, 1, 2); err != nil {
+		t.Fatalf("erasing saved permissions failed: %v", err)
+	}
+	want := []erased{{1, origin, CoreWebView2PermissionStateDefault}, {2, origin, CoreWebView2PermissionStateDefault}}
+	if len(calls) != 2 || calls[0] != want[0] || calls[1] != want[1] {
+		t.Fatalf("SetPermissionState calls %+v, want %+v", calls, want)
+	}
+	if len(reports) != 0 || pending() != 1 {
+		t.Fatalf("reported %v with %d requests pending before the runtime answered", reports, pending())
+	}
+	complete(handlers[0], 0)
+	if len(reports) != 0 {
+		t.Fatal("erasure was reported after only one of two kinds was answered")
+	}
+	complete(handlers[1], 0)
+	if len(reports) != 1 || !reports[0] || pending() != 0 {
+		t.Fatalf("after both answers: reports %v, pending %d; want one true and none pending", reports, pending())
+	}
+	// A late or repeated answer changes nothing.
+	complete(handlers[1], 0x80004005)
+	if len(reports) != 1 {
+		t.Fatalf("a repeated completion was reported again: %v", reports)
+	}
+	var same unsafe.Pointer
+	if hr, _, _ := handlers[0].vtbl.QueryInterface.Call(uintptr(unsafe.Pointer(handlers[0])), 0, uintptr(unsafe.Pointer(&same))); hr != 0 || same != unsafe.Pointer(handlers[0]) {
+		t.Fatal("the completion handler did not answer QueryInterface with itself")
+	}
+
+	// One kind fails asynchronously: the whole erasure is reported as failed.
+	calls, handlers, reports = nil, nil, nil
+	if err := build(true, true, nil).ForgetSavedPermissions(origin, report, 1, 2); err != nil {
+		t.Fatal(err)
+	}
+	complete(handlers[0], 0x80004005)
+	complete(handlers[1], 0)
+	if len(reports) != 1 || reports[0] {
+		t.Fatalf("an asynchronous failure was reported as %v, want one false", reports)
+	}
+
+	// One kind is refused at once and never calls back; the other succeeds.
+	calls, handlers, reports = nil, nil, nil
+	if err := build(true, true, map[CoreWebView2PermissionKind]bool{1: true}).ForgetSavedPermissions(origin, report, 1, 2); err != nil {
+		t.Fatal(err)
+	}
+	if len(calls) != 2 || len(handlers) != 1 || len(reports) != 0 {
+		t.Fatalf("after one refused request: calls %d, handlers %d, reports %v", len(calls), len(handlers), reports)
+	}
+	complete(handlers[0], 0)
+	if len(reports) != 1 || reports[0] || pending() != 0 {
+		t.Fatalf("a refused request was reported as %v with %d pending, want one false and none", reports, pending())
+	}
+
+	// Every kind refused at once: reported before the call returns.
+	calls, handlers, reports = nil, nil, nil
+	if err := build(true, true, map[CoreWebView2PermissionKind]bool{1: true, 2: true}).ForgetSavedPermissions(origin, report, 1, 2); err != nil || len(reports) != 1 || reports[0] || pending() != 0 {
+		t.Fatalf("all requests refused: error %v, reports %v, pending %d; want nil, one false, none", err, reports, pending())
+	}
+
+	// Runtimes without permission management request nothing, report nothing
+	// and say so; the caller must then treat saved answers as still present.
+	for name, e := range map[string]*Chromium{"no ICoreWebView2_13": build(false, true, nil), "no ICoreWebView2Profile4": build(true, false, nil)} {
+		calls, reports = nil, nil
+		if err := e.ForgetSavedPermissions(origin, report, 1); !errors.Is(err, UnsupportedCapabilityError) || len(calls) != 0 || len(reports) != 0 {
+			t.Fatalf("%s: error %v, calls %d, reports %v; want unsupported, none, none", name, err, len(calls), reports)
+		}
+	}
+	if err := (&Chromium{}).ForgetSavedPermissions(origin, report, 1); err == nil {
+		t.Fatal("erasing before the webview exists did not fail")
+	}
+	if err := build(true, true, nil).ForgetSavedPermissions(origin, nil, 1); err == nil {
+		t.Fatal("erasing without a completion callback did not fail")
+	}
+	if err := build(true, true, nil).ForgetSavedPermissions(origin, report); err == nil {
+		t.Fatal("erasing no kinds did not fail")
+	}
+}
