+	dropped := 0
+	parent := &WebviewWindow{options: WebviewWindowOptions{NativeFileDropHandler: func([]string) { dropped++ }, NativeFileDragHandler: func(active bool, _ uint64) { hints = append(hints, active) }}}
+	object := whatsUpDropFixtureObject(t, 0)
