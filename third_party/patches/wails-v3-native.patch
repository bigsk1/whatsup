+// SetCompletedReader publishes complete content, then waits without holding the
+// UI thread. Keeping this handler alive preserves browser abort tracking.
+func (rw *responseWriter) SetCompletedReader(ctx context.Context, reader io.ReadSeekCloser, length int64) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if rw.finished || rw.stream != nil || (rw.body != nil && rw.body.Len() != 0) {
+		return errors.New("completed content cannot replace a response")
+	}
+	var err error
+	rw.req.invokeSync(func() { rw.stream, err = edge.NewReaderStream(reader, length) })
+	if err != nil {
+		return err
+	}
+	stream := rw.stream
+	if err = rw.Finish(); err != nil {
+		_ = stream.Close()
+		stream.Release()
+		return err
+	}
+	stream.Release() // The response/browser owns the native references now.
+	select {
+	case <-stream.Done():
+		return stream.Err()
+	case <-ctx.Done():
+		complete := stream.Exhausted()
+		_ = stream.Close()
+		if complete {
+			return nil
+		}
+		return ctx.Err()
+	}
