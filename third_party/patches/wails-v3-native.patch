+package application
+
+import "testing"
+
+func TestWhatsUpNativeDragHintsAreScalarDeduplicatedAndRetired(t *testing.T) {
+	type hint struct {
+		active bool
+		serial uint64
+	}
+	var got []hint
+	drops := 0
+	w := &WebviewWindow{options: WebviewWindowOptions{NativeFileDropHandler: func([]string) { drops++ }, NativeFileDragHandler: func(active bool, serial uint64) { got = append(got, hint{active, serial}) }}}
+	w.deliverNativeFileDrag(false)
+	w.deliverNativeFileDrag(true)
+	for range 1000 {
+		w.deliverNativeFileDrag(true)
+	}
+	w.ResetNativeFileDrag()
+	w.deliverNativeFileDrag(false)
+	w.deliverNativeFileDrag(true)
+	w.deliverNativeFileDrag(false)
+	if len(got) != 4 || got[0] != (hint{true, 1}) || got[1] != (hint{false, 2}) || got[2] != (hint{true, 3}) || got[3] != (hint{false, 4}) || drops != 0 {
+		t.Fatal("hover read/delivered files or escaped scalar transition bounds")
+	}
+	w.destroyed = true
+	w.deliverNativeFileDrag(true)
+	if len(got) != 4 {
+		t.Fatal("destroyed window emitted a stale native hint")
+	}
+}
+
+func TestWhatsUpNativeDragRequiresPrivateDropModeAndNeverWraps(t *testing.T) {
+	called := 0
+	w := &WebviewWindow{options: WebviewWindowOptions{NativeFileDragHandler: func(bool, uint64) { called++ }}}
+	w.deliverNativeFileDrag(true)
+	if called != 0 {
+		t.Fatal("browser drop mode exposed native hints")
+	}
+	w.options.NativeFileDropHandler = func([]string) { t.Fatal("hover staged a file") }
+	w.nativeFileDragSerial = whatsUpNativeDragLastSerial - 1
+	w.options.NativeFileDragHandler = func(active bool, serial uint64) {
+		called++
+		if active || serial != whatsUpNativeDragLastSerial {
+			t.Fatal("exhausted serial was reused for an active hint")
+		}
+	}
+	w.deliverNativeFileDrag(true)
+	w.ResetNativeFileDrag()
+	w.deliverNativeFileDrag(true)
+	if called != 1 {
+		t.Fatal("serial exhaustion did not retire the hint stream")
+	}
+}
