+	windows.NewCallback(readerQueryInterface), windows.NewCallback(readerAddRef), windows.NewCallback(readerRelease),
+	windows.NewCallback(readerRead), windows.NewCallback(readerWrite), windows.NewCallback(readerSeek),
+	windows.NewCallback(readerSetSize), windows.NewCallback(readerCopyTo), windows.NewCallback(readerCommit),
+	windows.NewCallback(readerRevert), windows.NewCallback(readerLockRegion), windows.NewCallback(readerUnlockRegion),
+	windows.NewCallback(readerStat), windows.NewCallback(readerClone),
+}
+
+// NewReaderStream must run on a COM-initialized thread. The free-threaded
+// marshaler and serialized reader make native background reads supported.
+func NewReaderStream(reader io.ReadSeekCloser, length int64) (*ReaderStream, error) {
+	if reader == nil || length < 0 {
+		return nil, errors.New("invalid native reader")
+	}
+	memory, allocationError := windows.LocalAlloc(0, uint32(unsafe.Sizeof(readerStreamObject{})))
+	if allocationError != nil || memory == 0 {
+		return nil, errors.New("native reader allocation failed")
+	}
+	object := (*readerStreamObject)(unsafe.Pointer(memory))
+	object.vtable = &readerStreamVTable
