+)
+
+const contentLength int64 = (1 << 30) + 17
+const page = `<!doctype html><meta charset="utf-8"><script>
+(async()=>{try{
+ const total=1073741841;
+ for(const [range,start,count] of [['bytes=1048576-1114111',1048576,65536],['bytes=-4096',total-4096,4096]]){
+  const r=await fetch('/media',{headers:{Range:range}}); const data=new Uint8Array(await r.arrayBuffer());
+  if(r.status!==206||data.length!==count)throw Error('range');
+  for(let i=0;i<data.length;i++)if(data[i]!==((start+i)%251))throw Error('bytes');
+ }
+ const h=await fetch('/media',{method:'HEAD'});if(h.status!==200||Number(h.headers.get('Content-Length'))!==total)throw Error('head');
+ const c=new AbortController();setTimeout(()=>c.abort(),80);try{const r=await fetch('/abort',{signal:c.signal});await r.arrayBuffer();throw Error('abort absent')}catch(e){if(e.name!=='AbortError')throw e}
+ let closed=false;for(let i=0;i<20;i++){if(await(await fetch('/closed')).text()==='yes'){closed=true;break}await new Promise(r=>setTimeout(r,100))}if(!closed)throw Error('native abort not observed');
+ await fetch('/done',{method:'POST',body:'pass'});
+}catch(e){await fetch('/done',{method:'POST',body:'fail'})}})();
+</script>`
+
+type virtualReader struct {
+	position int64
+	slow     bool
+	closed   atomic.Bool
+	read     *atomic.Int64
+}
+
+func (r *virtualReader) Read(p []byte) (int, error) {
+	if r.closed.Load() {
+		return 0, io.ErrClosedPipe
+	}
+	if r.position >= contentLength {
+		return 0, io.EOF
+	}
+	if int64(len(p)) > contentLength-r.position {
+		p = p[:contentLength-r.position]
+	}
+	if r.slow {
+		time.Sleep(10 * time.Millisecond)
+	}
+	for i := range p {
+		p[i] = byte((r.position + int64(i)) % 251)
+	}
+	r.position += int64(len(p))
+	r.read.Add(int64(len(p)))
+	return len(p), nil
+}
+func (r *virtualReader) Seek(n int64, origin int) (int64, error) {
+	switch origin {
+	case io.SeekStart:
+	case io.SeekCurrent:
+		n += r.position
+	case io.SeekEnd:
+		n += contentLength
+	default:
+		return 0, errors.New("seek")
+	}
+	if n < 0 || n > contentLength {
+		return 0, errors.New("seek")
+	}
+	r.position = n
+	return n, nil
+}
+func (r *virtualReader) Close() error { r.closed.Store(true); return nil }
+
+type probe struct {
+	app         *application.App
+	active      sync.WaitGroup
+	finished    atomic.Bool
+	passed      atomic.Bool
+	abortBytes  atomic.Int64
+	streamBytes atomic.Int64
+	abortClosed atomic.Bool
+}
+
+func (p *probe) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	switch r.URL.Path {
+	case "/":
+		w.Header().Set("Content-Type", "text/html; charset=utf-8")
+		io.WriteString(w, page)
+	case "/media", "/abort":
+		p.active.Add(1)
+		defer p.active.Done()
+		slow := r.URL.Path == "/abort"
+		counter := &p.streamBytes
+		if slow {
+			counter = &p.abortBytes
+		}
+		reader := &virtualReader{slow: slow, read: counter}
+		w.Header().Set("Content-Type", "application/octet-stream")
+		w.Header().Set("X-Content-Type-Options", "nosniff")
+		w.Header().Set("Content-Security-Policy", "default-src 'none'; sandbox")
+		w.Header().Set("Cache-Control", "no-store")
+		_ = application.ServeCompletedReader(w, r, reader, contentLength)
+		if slow && reader.closed.Load() {
+			p.abortClosed.Store(true)
+		}
+	case "/done":
+		data, _ := io.ReadAll(io.LimitReader(r.Body, 16))
+		p.passed.Store(string(data) == "pass")
+		p.finished.Store(true)
+		w.WriteHeader(204)
+		go func() { time.Sleep(100 * time.Millisecond); p.app.Quit() }()
+	case "/closed":
+		w.Header().Set("Content-Type", "text/plain")
+		if p.abortClosed.Load() {
+			io.WriteString(w, "yes")
+		} else {
+			io.WriteString(w, "no")
+		}
+	default:
+		w.WriteHeader(404)
+	}
+}
+func run() error {
+	log.SetOutput(io.Discard)
+	directory, err := os.Getwd()
+	if err != nil {
+		return err
+	}
+	p := &probe{}
+	app := application.New(application.Options{Name: "WhatsUpNativePatchQA", Logger: slog.New(slog.NewTextHandler(io.Discard, nil)), Assets: application.AssetOptions{Handler: p}, Windows: application.WindowsOptions{WebviewUserDataPath: filepath.Join(directory, "webview"), DisableQuitOnLastWindowClosed: true}})
+	p.app = app
+	app.Window.NewWithOptions(application.WebviewWindowOptions{Title: "WhatsUp native patch QA", Hidden: true, URL: "/", NativeFileDropHandler: func([]string) {}})
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	go func() { <-ctx.Done(); app.Quit() }()
+	if err := app.Run(); err != nil {
+		return err
+	}
+	done := make(chan struct{})
+	go func() { p.active.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		return errors.New("native media handler did not stop")
+	}
+	if !p.finished.Load() || !p.passed.Load() || !p.abortClosed.Load() || p.abortBytes.Load() >= 16<<20 {
+		return errors.New("native reader/drop initialization or cancellation failed")
+	}
+	return json.NewEncoder(os.Stdout).Encode(map[string]any{"nativeReaderRanges": true, "strictDropInitialized": true, "abortClosed": true, "abortBytes": p.abortBytes.Load(), "rangeBytes": p.streamBytes.Load()})
+}
+func main() {
+	if err := run(); err != nil {
+		os.Stderr.WriteString(err.Error() + "\n")
+		os.Exit(1)
+	}
+}
