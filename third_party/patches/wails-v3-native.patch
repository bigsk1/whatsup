+//go:build linux && !android && !gtk3 && !purego && !server
+
+#include "linux_cgo.h"
+#include <string.h>
+
+// The top-level capture controller owns every drop before WebKit. Only a
+// bounded local URI list is read; arbitrary browser File objects are not made.
+typedef struct {
+    GdkDrop *drop;
+    GCancellable *cancel;
+    GInputStream *stream;
+    GByteArray *bytes;
+    guint timeout;
+    uintptr_t window;
+    gint x, y;
+} WhatsUpNativeDrop;
+
+static guint whatsup_native_drop_pending = 0;
+static const char *whatsup_native_drop_mimes[] = { "text/uri-list", NULL };
+
+static gboolean whatsup_native_drop_timeout(gpointer data) {
+    WhatsUpNativeDrop *state = data;
+    state->timeout = 0;
+    g_cancellable_cancel(state->cancel);
+    return G_SOURCE_REMOVE;
+}
+
+static void whatsup_native_drop_finish(WhatsUpNativeDrop *state, gboolean accepted) {
+    if (state->timeout != 0) g_source_remove(state->timeout);
+    if (state->stream != NULL) {
+        g_input_stream_close_async(state->stream, G_PRIORITY_DEFAULT, NULL, NULL, NULL);
+        g_object_unref(state->stream);
+    }
+    gdk_drop_finish(state->drop, accepted ? GDK_ACTION_COPY : 0);
+    g_object_unref(state->drop);
+    g_object_unref(state->cancel);
+    g_byte_array_unref(state->bytes);
+    g_free(state);
+    whatsup_native_drop_pending--;
+}
+
+static gboolean whatsup_native_drop_paths(WhatsUpNativeDrop *state) {
+    if (state->bytes->len == 0 || state->bytes->len > (256u << 10) || !g_utf8_validate((const char *)state->bytes->data, state->bytes->len, NULL)) return FALSE;
+    g_byte_array_append(state->bytes, (const guint8 *)"", 1);
+    char **uris = g_uri_list_extract_uris((const char *)state->bytes->data);
+    if (uris == NULL) return FALSE;
+    guint count = g_strv_length(uris);
+    if (count == 0 || count > 16) { g_strfreev(uris); return FALSE; }
+    char **paths = g_new0(char *, count + 1);
+    gboolean valid = TRUE;
+    for (guint index = 0; index < count; index++) {
+        GFile *file = g_file_new_for_uri(uris[index]);
+        paths[index] = g_file_get_path(file);
+        g_object_unref(file);
+        if (paths[index] == NULL) valid = FALSE;
+    }
+    if (valid) onDropFiles(paths, state->x, state->y, state->window);
+    for (guint index = 0; index < count; index++) g_free(paths[index]);
+    g_free(paths);
+    g_strfreev(uris);
+    return valid;
+}
+
+static void whatsup_native_drop_read(GObject *source, GAsyncResult *result, gpointer data);
+
+static void whatsup_native_drop_read( GObject *source, GAsyncResult *result, gpointer data) {
+    WhatsUpNativeDrop *state = data;
+    GError *error = NULL;
+    GBytes *chunk = g_input_stream_read_bytes_finish(G_INPUT_STREAM(source), result, &error);
+    if (error != NULL || chunk == NULL) {
+        if (error != NULL) g_error_free(error);
+        if (chunk != NULL) g_bytes_unref(chunk);
+        whatsup_native_drop_finish(state, FALSE);
+        return;
+    }
+    gsize length;
+    const guint8 *bytes = g_bytes_get_data(chunk, &length);
+    if (length == 0) {
+        g_bytes_unref(chunk);
+        gboolean accepted = whatsup_native_drop_paths(state);
+        whatsup_native_drop_finish(state, accepted);
+        return;
+    }
+    if (length > (256u << 10) - state->bytes->len) {
+        g_bytes_unref(chunk);
+        whatsup_native_drop_finish(state, FALSE);
+        return;
+    }
+    g_byte_array_append(state->bytes, bytes, length);
+    g_bytes_unref(chunk);
+    g_input_stream_read_bytes_async(state->stream, 16u << 10, G_PRIORITY_DEFAULT, state->cancel, whatsup_native_drop_read, state);
+}
+
+static void whatsup_native_drop_open(GObject *source, GAsyncResult *result, gpointer data) {
+    WhatsUpNativeDrop *state = data;
+    GError *error = NULL;
+    const char *mime = NULL;
+    state->stream = gdk_drop_read_finish(GDK_DROP(source), result, &mime, &error);
+    if (error != NULL || state->stream == NULL || mime == NULL || strcmp(mime, "text/uri-list") != 0) {
+        if (error != NULL) g_error_free(error);
+        whatsup_native_drop_finish(state, FALSE);
+        return;
+    }
+    g_input_stream_read_bytes_async(state->stream, 16u << 10, G_PRIORITY_DEFAULT, state->cancel, whatsup_native_drop_read, state);
+}
+
+static gboolean whatsup_native_drag_copy_supported(GdkContentFormats *formats, GdkDragAction actions) {
+    return (actions & GDK_ACTION_COPY) && formats != NULL && gdk_content_formats_contain_mime_type(formats, "text/uri-list");
+}
+
+static gboolean whatsup_native_drop_accept(GtkDropTargetAsync *target, GdkDrop *drop, gpointer data) { return TRUE; }
+static GdkDragAction whatsup_native_drop_enter(GtkDropTargetAsync *target, GdkDrop *drop, double x, double y, gpointer data) {
+    GdkDragAction actions = gdk_drop_get_actions(drop);
+    GdkContentFormats *formats = gdk_drop_get_formats(drop);
+    gboolean active = whatsup_native_drag_copy_supported(formats, actions);
+    onNativeFileDrag(active ? 1 : 0, (uintptr_t)data);
+    if (actions & GDK_ACTION_COPY) return GDK_ACTION_COPY;
+    if (actions & GDK_ACTION_MOVE) return GDK_ACTION_MOVE;
+    if (actions & GDK_ACTION_LINK) return GDK_ACTION_LINK;
+    return actions & GDK_ACTION_ASK;
+}
+static void whatsup_native_drop_leave(GtkDropTargetAsync *target, GdkDrop *drop, gpointer data) {
+    onNativeFileDrag(0, (uintptr_t)data);
+}
+
+static gboolean whatsup_native_drop_received(GtkDropTargetAsync *target, GdkDrop *drop, double x, double y, gpointer data) {
+    onNativeFileDrag(0, (uintptr_t)data);
+    // Consume unsupported actions/formats too; they must not fall through.
+    if (whatsup_native_drop_pending >= 8 || !(gdk_drop_get_actions(drop) & GDK_ACTION_COPY)) { gdk_drop_finish(drop, 0); return TRUE; }
+    whatsup_native_drop_pending++;
+    WhatsUpNativeDrop *state = g_new0(WhatsUpNativeDrop, 1);
+    state->drop = g_object_ref(drop);
+    state->cancel = g_cancellable_new();
+    state->bytes = g_byte_array_new();
+    state->window = (uintptr_t)data;
+    state->x = (gint)x; state->y = (gint)y;
+    state->timeout = g_timeout_add_seconds(5, whatsup_native_drop_timeout, state);
+    gdk_drop_read_async(drop, whatsup_native_drop_mimes, G_PRIORITY_DEFAULT, state->cancel, whatsup_native_drop_open, state);
+    return TRUE;
+}
+
+void enableNativeDND(GtkWidget *window, uintptr_t winID) {
+    GtkDropTargetAsync *target = gtk_drop_target_async_new(NULL, GDK_ACTION_COPY | GDK_ACTION_MOVE | GDK_ACTION_LINK | GDK_ACTION_ASK);
+    gtk_event_controller_set_propagation_phase(GTK_EVENT_CONTROLLER(target), GTK_PHASE_CAPTURE);
+    g_signal_connect(target, "accept", G_CALLBACK(whatsup_native_drop_accept), (gpointer)winID);
+    g_signal_connect(target, "drag-enter", G_CALLBACK(whatsup_native_drop_enter), (gpointer)winID);
+    g_signal_connect(target, "drag-motion", G_CALLBACK(whatsup_native_drop_enter), (gpointer)winID);
+    g_signal_connect(target, "drag-leave", G_CALLBACK(whatsup_native_drop_leave), (gpointer)winID);
+    g_signal_connect(target, "drop", G_CALLBACK(whatsup_native_drop_received), (gpointer)winID);
+    gtk_widget_add_controller(window, GTK_EVENT_CONTROLLER(target));
+}
