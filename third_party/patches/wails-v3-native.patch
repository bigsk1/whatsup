+// ReaderStream exposes complete immutable content without copying it into an
+// HGLOBAL. All callbacks are global: allocating one stream does not consume more
+// runtime callback slots. The native object is rooted until its final Release.
+type ReaderStream struct {
+	mu               sync.Mutex
+	native           *readerStreamObject
+	reader           io.ReadSeekCloser
+	length, position int64
+	refs             atomic.Int64
+	closed           atomic.Bool
+	failed           atomic.Bool
+	done             chan struct{}
+	once             sync.Once
+	marshaler        uintptr
+}
+type readerStreamObject struct{ vtable *[14]uintptr }
