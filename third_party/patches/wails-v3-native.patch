+var readerStreams = struct {
+	sync.RWMutex
+	states map[uintptr]*ReaderStream
+}{states: make(map[uintptr]*ReaderStream)}
+var createReaderMarshaler = windows.NewLazySystemDLL("ole32.dll").NewProc("CoCreateFreeThreadedMarshaler")
+
+func readerGUID(s string) windows.GUID {
+	value, err := windows.GUIDFromString(s)
+	if err != nil {
+		panic(err)
+	}
+	return value
+}
+
+var readerIUnknown = readerGUID("{00000000-0000-0000-C000-000000000046}")
+var readerISequentialStream = readerGUID("{0c733a30-2a1c-11ce-ade5-00aa0044773d}")
+var readerIStream = readerGUID("{0000000c-0000-0000-C000-000000000046}")
+var readerIAgile = readerGUID("{94ea2b94-e9cc-49e0-c0ff-ee64ca8f5b90}")
+var readerIMarshal = readerGUID("{00000003-0000-0000-C000-000000000046}")
+var readerStreamVTable = [14]uintptr{
+	windows.NewCallback(readerQueryInterface), windows.NewCallback(readerAddRef), windows.NewCallback(readerRelease),
+	windows.NewCallback(readerRead), windows.NewCallback(readerWrite), windows.NewCallback(readerSeek),
+	windows.NewCallback(readerSetSize), windows.NewCallback(readerCopyTo), windows.NewCallback(readerCommit),
+	windows.NewCallback(readerRevert), windows.NewCallback(readerLockRegion), windows.NewCallback(readerUnlockRegion),
+	windows.NewCallback(readerStat), windows.NewCallback(readerClone),
+}
+
+// NewReaderStream must run on a COM-initialized thread. The free-threaded
+// marshaler and serialized reader make native background reads supported.
+func NewReaderStream(reader io.ReadSeekCloser, length int64) (*ReaderStream, error) {
+	if reader == nil || length < 0 {
+		return nil, errors.New("invalid native reader")
+	}
+	memory, allocationError := windows.LocalAlloc(0, uint32(unsafe.Sizeof(readerStreamObject{})))
+	if allocationError != nil || memory == 0 {
+		return nil, errors.New("native reader allocation failed")
+	}
+	object := (*readerStreamObject)(unsafe.Pointer(memory))
+	object.vtable = &readerStreamVTable
+	s := &ReaderStream{reader: reader, length: length, done: make(chan struct{}), native: object}
+	s.refs.Store(1)
+	this := uintptr(unsafe.Pointer(s.native))
+	readerStreams.Lock()
+	readerStreams.states[this] = s
+	readerStreams.Unlock()
+	hr, _, _ := createReaderMarshaler.Call(this, uintptr(unsafe.Pointer(&s.marshaler)))
+	if int32(hr) < 0 || s.marshaler == 0 {
+		readerRelease(this)
+		return nil, errors.New("native reader marshaler unavailable")
+	}
+	return s, nil
+}
+func (s *ReaderStream) IStream() *IStream     { return (*IStream)(unsafe.Pointer(s.native)) }
+func (s *ReaderStream) Done() <-chan struct{} { return s.done }
+func (s *ReaderStream) Err() error {
