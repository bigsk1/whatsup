+//go:build windows
+
+package application
+
+import (
+	"time"
+
+	"github.com/wailsapp/wails/v3/internal/assetserver"
+	"github.com/wailsapp/wails/v3/internal/webview2/pkg/edge"
+)
+
+// whatsupPermissionKinds are the kinds whose saved answers are erased when a
+// window with a permission policy starts.
+var whatsupPermissionKinds = []edge.CoreWebView2PermissionKind{
+	edge.CoreWebView2PermissionKind(CoreWebView2PermissionKindMicrophone),
+	edge.CoreWebView2PermissionKind(CoreWebView2PermissionKindCamera),
+	edge.CoreWebView2PermissionKind(CoreWebView2PermissionKindGeolocation),
+	edge.CoreWebView2PermissionKind(CoreWebView2PermissionKindNotifications),
+	edge.CoreWebView2PermissionKind(CoreWebView2PermissionKindOtherSensors),
+	edge.CoreWebView2PermissionKind(CoreWebView2PermissionKindClipboardRead),
+}
+
+// whatsupPermissionAnswer looks one kind up in the two permission tables as
+// they are now. The Windows-specific table wins, as it does when a window is
+// created. The cross-platform table is the map the application passed in, not
+// a copy, so an application that changes an entry on the main thread changes
+// the answer to the next request. Requests are raised on that same thread.
+func whatsupPermissionAnswer(kind edge.CoreWebView2PermissionKind, specific map[CoreWebView2PermissionKind]CoreWebView2PermissionState, general map[PermissionType]Permission) (edge.CoreWebView2PermissionState, bool) {
+	if state, ok := specific[CoreWebView2PermissionKind(kind)]; ok {
+		return edge.CoreWebView2PermissionState(state), true
+	}
+	for permission, state := range general {
+		if crossPermissionToWebView2Kind(permission) == kind && kind != edge.CoreWebView2PermissionKind(CoreWebView2PermissionKindUnknownPermission) {
+			return edge.CoreWebView2PermissionState(state), true
+		}
+	}
+	return edge.CoreWebView2PermissionStateDefault, false
+}
+
+func (w *windowsWebviewWindow) whatsupPermissionSource(specific map[CoreWebView2PermissionKind]CoreWebView2PermissionState) func(edge.CoreWebView2PermissionKind) (edge.CoreWebView2PermissionState, bool) {
+	return func(kind edge.CoreWebView2PermissionKind) (edge.CoreWebView2PermissionState, bool) {
+		return whatsupPermissionAnswer(kind, specific, w.parent.options.Permissions)
+	}
+}
+
+// whatsupPermissionResetTimeout bounds the wait for the runtime to confirm the
+// erasure. It normally answers within milliseconds.
+const whatsupPermissionResetTimeout = 5 * time.Second
+
+// whatsupSecurePermissionsFirst erases answers an earlier build left in the
+// profile for the application's own origin before any page is loaded in this
+// webview. A saved Allow is honoured by WebView2 without raising the request
+// event, so no page may run before the runtime has confirmed the erasure, and
+// a failure or a missing answer must be known to the application before any
+// script can ask for a device.
+//
+// It reports whether navigation was put off. When it was, navigateInitialPage
+// runs again once the answer is known. The window's PermissionsSecured option
+// receives that answer first; it is called once for each webview the window
+// creates, including one rebuilt after a renderer failure.
+func (w *windowsWebviewWindow) whatsupSecurePermissionsFirst(chromium *edge.Chromium) (deferred bool) {
+	if chromium == nil || chromium.PermissionSource == nil || chromium.PermissionsSettled {
+		return false
+	}
+	settle := func(secured bool) {
+		if chromium.PermissionsSettled {
+			return
+		}
+		chromium.PermissionsSettled = true
+		chromium.PermissionsSecured = secured
+		if !secured {
+			globalApplication.warning("webview2: saved permissions were not confirmed erased; device permissions stay denied for this webview")
+		}
+		if report := w.parent.options.Windows.PermissionsSecured; report != nil {
+			report(secured)
+		}
+		if w.chromium == chromium {
+			w.navigateInitialPage()
+		}
+	}
+	origin, err := assetserver.GetStartURL("")
+	if err == nil {
+		err = chromium.ForgetSavedPermissions(origin, settle, whatsupPermissionKinds...)
+	}
+	if err != nil {
+		settle(false)
+		return true
+	}
+	if !chromium.PermissionsSettled {
+		time.AfterFunc(whatsupPermissionResetTimeout, func() { InvokeAsync(func() { settle(false) }) })
+	}
+	return true
+}
