+//go:build windows && !server && (amd64 || arm64)
+
+package application
+
+import (
+	"errors"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Native-only OLE ownership: no IDataObject or file is forwarded to WebView2.
+// POINTL is packed into one argument by the 64-bit Windows ABI.
+type whatsUpNativeDrop struct {
+	native   uintptr
+	refs     atomic.Int64
+	window   *windowsWebviewWindow
+	accepted bool
+}
+
+var nativeDropObjects = struct {
+	sync.RWMutex
+	entries map[uintptr]*whatsUpNativeDrop
+}{entries: make(map[uintptr]*whatsUpNativeDrop)}
+var nativeDropVTable = [7]uintptr{windows.NewCallback(nativeDropQuery), windows.NewCallback(nativeDropAddRef), windows.NewCallback(nativeDropRelease), windows.NewCallback(nativeDropEnter), windows.NewCallback(nativeDropOver), windows.NewCallback(nativeDropLeave), windows.NewCallback(nativeDropDrop)}
+var nativeDropOle = windows.NewLazySystemDLL("ole32.dll")
+var nativeDropRegister = nativeDropOle.NewProc("RegisterDragDrop")
+var nativeDropRevoke = nativeDropOle.NewProc("RevokeDragDrop")
+var nativeDropInitialize = nativeDropOle.NewProc("OleInitialize")
+var nativeDropUninitialize = nativeDropOle.NewProc("OleUninitialize")
+var nativeDropReleaseMedium = nativeDropOle.NewProc("ReleaseStgMedium")
+var nativeDropQueryFile = windows.NewLazySystemDLL("shell32.dll").NewProc("DragQueryFileW")
+var nativeDropIUnknown, _ = windows.GUIDFromString("{00000000-0000-0000-C000-000000000046}")
+var nativeDropIID, _ = windows.GUIDFromString("{00000122-0000-0000-C000-000000000046}")
+
+type nativeDropFormat struct {
+	format uint16
+	target uintptr
+	aspect uint32
+	index  int32
+	medium uint32
+}
+type nativeDropMedium struct {
+	kind    uint32
+	handle  uintptr
+	release uintptr
+}
+
+func (w *windowsWebviewWindow) startNativeDrop() error {
+	if w.nativeDrop != nil {
+		return nil
+	}
+	hr, _, _ := nativeDropInitialize.Call(0)
+	if int32(hr) < 0 {
+		return errors.New("native drop OLE initialization failed")
+	}
+	memory, allocationError := windows.LocalAlloc(0, uint32(unsafe.Sizeof(uintptr(0))))
+	if allocationError != nil || memory == 0 {
+		nativeDropUninitialize.Call()
+		return errors.New("native drop allocation failed")
+	}
+	address := uintptr(memory)
+	*(*uintptr)(unsafe.Pointer(address)) = uintptr(unsafe.Pointer(&nativeDropVTable))
+	d := &whatsUpNativeDrop{native: address, window: w}
+	d.refs.Store(1)
+	nativeDropObjects.Lock()
+	nativeDropObjects.entries[address] = d
+	nativeDropObjects.Unlock()
+	hr, _, _ = nativeDropRegister.Call(uintptr(w.hwnd), address)
+	if int32(hr) < 0 {
+		nativeDropRelease(address)
+		nativeDropUninitialize.Call()
+		return errors.New("native drop registration failed")
+	}
+	w.nativeDrop = d
+	return nil
+}
+func (w *windowsWebviewWindow) stopNativeDrop() {
+	if w.nativeDrop == nil {
+		return
+	}
+	d := w.nativeDrop
+	w.nativeDrop = nil
+	_, _, _ = nativeDropRevoke.Call(uintptr(w.hwnd))
+	nativeDropRelease(d.native)
+	nativeDropUninitialize.Call()
+}
+func nativeDropState(this uintptr) *whatsUpNativeDrop {
+	nativeDropObjects.RLock()
+	d := nativeDropObjects.entries[this]
+	nativeDropObjects.RUnlock()
+	return d
+}
+func nativeDropQuery(this, riid, out uintptr) uintptr {
+	if riid == 0 || out == 0 {
+		return 0x80004003
+	}
+	*(*uintptr)(unsafe.Pointer(out)) = 0
+	id := *(*windows.GUID)(unsafe.Pointer(riid))
+	if id != nativeDropIUnknown && id != nativeDropIID {
+		return 0x80004002
+	}
+	if nativeDropAddRef(this) == 0 {
+		return 0x80004002
+	}
+	*(*uintptr)(unsafe.Pointer(out)) = this
+	return 0
+}
+func nativeDropAddRef(this uintptr) uintptr {
+	if d := nativeDropState(this); d != nil {
+		return uintptr(d.refs.Add(1))
+	}
+	return 0
+}
+func nativeDropRelease(this uintptr) uintptr {
+	d := nativeDropState(this)
+	if d == nil {
+		return 0
+	}
+	n := d.refs.Add(-1)
+	if n == 0 {
+		nativeDropObjects.Lock()
+		delete(nativeDropObjects.entries, this)
+		nativeDropObjects.Unlock()
+		_, _ = windows.LocalFree(windows.Handle(this))
+	}
+	return uintptr(n)
+}
+func nativeDropSupports(data uintptr) bool {
+	if data == 0 {
+		return false
+	}
+	vt := *(*[12]uintptr)(unsafe.Pointer(*(*uintptr)(unsafe.Pointer(data))))
+	f := nativeDropFormat{format: 15, aspect: 1, index: -1, medium: 1}
+	hr, _, _ := syscall.SyscallN(vt[5], data, uintptr(unsafe.Pointer(&f)))
+	return int32(hr) == 0
+}
+func nativeDropEnter(this, data, key, point, effect uintptr) uintptr {
+	d := nativeDropState(this)
+	if effect == 0 || d == nil {
+		return 0x80004003
+	}
+	d.accepted = nativeDropSupports(data)
+	if d.accepted {
+		*(*uint32)(unsafe.Pointer(effect)) &= 1
+	} else {
+		*(*uint32)(unsafe.Pointer(effect)) = 0
+	}
+	return 0
+}
+func nativeDropOver(this, key, point, effect uintptr) uintptr {
+	d := nativeDropState(this)
+	if effect == 0 || d == nil {
+		return 0x80004003
+	}
+	if d.accepted {
+		*(*uint32)(unsafe.Pointer(effect)) &= 1
+	} else {
+		*(*uint32)(unsafe.Pointer(effect)) = 0
+	}
+	return 0
+}
+func nativeDropLeave(this uintptr) uintptr {
+	if d := nativeDropState(this); d != nil {
+		d.accepted = false
+	}
+	return 0
+}
+func nativeDropDrop(this, data, key, point, effect uintptr) uintptr {
+	if effect == 0 {
+		return 0x80004003
+	}
+	*(*uint32)(unsafe.Pointer(effect)) = 0
+	d := nativeDropState(this)
+	if d == nil || !nativeDropSupports(data) {
+		return 0
+	}
+	d.accepted = false
+	f := nativeDropFormat{format: 15, aspect: 1, index: -1, medium: 1}
+	var medium nativeDropMedium
+	vt := *(*[12]uintptr)(unsafe.Pointer(*(*uintptr)(unsafe.Pointer(data))))
+	hr, _, _ := syscall.SyscallN(vt[3], data, uintptr(unsafe.Pointer(&f)), uintptr(unsafe.Pointer(&medium)))
+	if int32(hr) < 0 {
+		return 0
+	}
+	defer nativeDropReleaseMedium.Call(uintptr(unsafe.Pointer(&medium)))
+	if medium.kind != 1 || medium.handle == 0 {
+		return 0
+	}
+	count, _, _ := nativeDropQueryFile.Call(medium.handle, 0xffffffff, 0, 0)
+	if count == 0 || count > 16 {
+		return 0
+	}
+	paths := make([]string, 0, int(count))
+	total := 0
+	for i := uintptr(0); i < count; i++ {
+		length, _, _ := nativeDropQueryFile.Call(medium.handle, i, 0, 0)
+		if length == 0 || length > 32767 || total+int(length) > 65536 {
+			return 0
+		}
+		buffer := make([]uint16, int(length)+1)
+		n, _, _ := nativeDropQueryFile.Call(medium.handle, i, uintptr(unsafe.Pointer(&buffer[0])), length+1)
+		if n != length {
+			return 0
+		}
+		paths = append(paths, windows.UTF16ToString(buffer))
+		total += int(length)
+	}
+	if !d.window.parent.isDestroyed() && d.window.parent.deliverNativeFiles(paths) {
+		*(*uint32)(unsafe.Pointer(effect)) = 1
+	}
+	return 0
+}
