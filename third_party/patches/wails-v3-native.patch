+//go:build linux && !android && !gtk3 && !purego && !server
+
+package application
+
+import (
+	"context"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestWhatsUpNativeURIListBoundsAndLocalOnly(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	flags, err := exec.CommandContext(ctx, "pkg-config", "--cflags", "--libs", "gtk4", "webkitgtk-6.0").Output()
+	if err != nil {
+		t.Fatal("native GTK4 development flags unavailable")
+	}
+	// These are the same trusted system SDK flags used by the cgo backend;
+	// execution never goes through a shell. Refuse quoting instead of guessing.
+	if strings.ContainsAny(string(flags), `'"\`) {
+		t.Fatal("native test SDK paths need an explicit argument parser")
+	}
+	binary := filepath.Join(t.TempDir(), "uri-parser")
+	args := []string{"-Wall", "-Wextra", "-Wno-unused-parameter", filepath.Join("testdata", "whatsup-native-uri", "main.c"), "-o", binary}
+	args = append(args, strings.Fields(string(flags))...)
+	if output, err := exec.CommandContext(ctx, "cc", args...).CombinedOutput(); err != nil {
+		t.Fatalf("native URI probe compile: %v\n%s", err, output)
+	}
+	output, err := exec.CommandContext(ctx, binary).CombinedOutput()
+	if err != nil || strings.TrimSpace(string(output)) != `{"cases":12,"passed":true}` {
+		t.Fatalf("native URI bounds/local-only probe failed: %v", err)
+	}
+}
