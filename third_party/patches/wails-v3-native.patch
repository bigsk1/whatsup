+// SetCompletedReader publishes complete content, then waits without holding the
+// UI thread. Keeping this handler alive preserves browser abort tracking.
+func (rw *responseWriter) SetCompletedReader(ctx context.Context, reader io.ReadSeekCloser, length int64) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
