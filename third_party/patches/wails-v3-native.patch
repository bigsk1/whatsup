+package application
+
+import (
+	"testing"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+type whatsUpDropFixture struct {
+	vtable    *[12]uintptr
+	handle    uintptr
+	supported bool
+	reads     int
+}
+
+var whatsUpDropFixtureTable = [12]uintptr{0, 0, 0, windows.NewCallback(whatsUpDropFixtureData), 0, windows.NewCallback(whatsUpDropFixtureQuery)}
+
+// OLE passes only native memory to these callbacks. Fixtures do the same, so
+// checkptr (enabled by -race) can reject any Go address passed as a uintptr.
+func whatsUpNativeValue[T any](t *testing.T, value T) *T {
+	t.Helper()
+	memory, err := windows.LocalAlloc(0, uint32(unsafe.Sizeof(value)))
+	if err != nil || memory == 0 {
+		t.Fatal("native fixture allocation")
+	}
+	t.Cleanup(func() { _, _ = windows.LocalFree(windows.Handle(memory)) })
+	pointer := (*T)(unsafe.Pointer(memory))
+	*pointer = value
+	return pointer
+}
+func whatsUpDropFixtureObject(t *testing.T, handle uintptr) *whatsUpDropFixture {
+	return whatsUpNativeValue(t, whatsUpDropFixture{vtable: whatsUpNativeValue(t, whatsUpDropFixtureTable), handle: handle, supported: true})
+}
+
+// The production caller passes its own FORMATETC and STGMEDIUM, as real OLE
+// expects. Native code copies them, so this fake does the same instead of
+// turning those Go addresses back into pointers.
+var whatsUpMoveMemory = windows.NewLazySystemDLL("kernel32.dll").NewProc("RtlMoveMemory")
+
+func whatsUpDropFixtureQuery(this, format uintptr) uintptr {
+	object := (*whatsUpDropFixture)(unsafe.Pointer(this))
+	var value nativeDropFormat
+	whatsUpMoveMemory.Call(uintptr(unsafe.Pointer(&value)), format, unsafe.Sizeof(value))
+	if !object.supported || value.format != 15 || value.aspect != 1 || value.index != -1 || value.medium != 1 {
+		return 0x80040064
+	}
+	return 0
+}
+func whatsUpDropFixtureData(this, format, out uintptr) uintptr {
+	if whatsUpDropFixtureQuery(this, format) != 0 {
+		return 0x80040064
+	}
+	object := (*whatsUpDropFixture)(unsafe.Pointer(this))
+	object.reads++
+	medium := nativeDropMedium{kind: 1, handle: object.handle}
+	whatsUpMoveMemory.Call(out, uintptr(unsafe.Pointer(&medium)), unsafe.Sizeof(medium))
+	object.handle = 0
+	return 0
+}
+func whatsUpDropFixtureHandle(t *testing.T, paths []string) uintptr {
+	t.Helper()
+	var values []uint16
+	for _, path := range paths {
+		value, err := windows.UTF16FromString(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		values = append(values, value...)
+	}
+	values = append(values, 0)
+	kernel := windows.NewLazySystemDLL("kernel32.dll")
+	size := 20 + 2*len(values)
+	handle, _, _ := kernel.NewProc("GlobalAlloc").Call(2, uintptr(size))
+	if handle == 0 {
+		t.Fatal("fixture allocation")
+	}
+	pointer, _, _ := kernel.NewProc("GlobalLock").Call(handle)
+	if pointer == 0 {
+		t.Fatal("fixture lock")
+	}
+	data := unsafe.Slice((*byte)(unsafe.Pointer(pointer)), size)
+	clear(data)
+	*(*uint32)(unsafe.Pointer(pointer)) = 20
+	*(*int32)(unsafe.Pointer(pointer + 16)) = 1
+	copy(unsafe.Slice((*uint16)(unsafe.Pointer(pointer+20)), len(values)), values)
+	kernel.NewProc("GlobalUnlock").Call(handle)
+	return handle
+}
+func TestWhatsUpNativeDropUsesRealHDROPAndReleasesMedium(t *testing.T) {
+	for _, count := range []int{1, 16, 17} {
+		paths := make([]string, count)
+		for index := range paths {
+			paths[index] = `C:\synthetic\drop.pdf`
+		}
+		handle := whatsUpDropFixtureHandle(t, paths)
+		object := whatsUpDropFixtureObject(t, handle)
+		var received []string
+		parent := &WebviewWindow{options: WebviewWindowOptions{NativeFileDropHandler: func(paths []string) { received = paths }}}
+		native := &windowsWebviewWindow{parent: parent}
+		memory, err := windows.LocalAlloc(0, uint32(unsafe.Sizeof(uintptr(0))))
+		if err != nil {
+			t.Fatal(err)
+		}
+		address := uintptr(memory)
+		*(*uintptr)(unsafe.Pointer(address)) = uintptr(unsafe.Pointer(&nativeDropVTable))
+		state := &whatsUpNativeDrop{native: address, window: native}
+		state.refs.Store(1)
+		nativeDropObjects.Lock()
+		nativeDropObjects.entries[address] = state
+		nativeDropObjects.Unlock()
+		effect := whatsUpNativeValue(t, uint32(1))
+		hr := nativeDropDrop(address, uintptr(unsafe.Pointer(object)), 0, 0, uintptr(unsafe.Pointer(effect)))
+		nativeDropRelease(address)
+		if hr != 0 || object.handle != 0 {
+			t.Fatal("native data not consumed")
+		}
+		if count <= 16 {
+			if *effect != 1 || len(received) != count || received[0] != paths[0] {
+				t.Fatal("native local paths not delivered")
+			}
+		} else if *effect != 0 || len(received) != 0 {
+			t.Fatal("oversized drop reached application")
+		}
+		size, _, _ := windows.NewLazySystemDLL("kernel32.dll").NewProc("GlobalSize").Call(handle)
+		if size != 0 {
+			t.Fatal("drop medium was not released")
+		}
+	}
+}
