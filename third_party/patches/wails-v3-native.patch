+package application
+
+// The serial remains exactly representable by the renderer. Reserve the last
+// value for an inactive retirement, never wrap back to a live old generation.
+const whatsUpNativeDragLastSerial uint64 = 1<<53 - 1
+
+func (w *WebviewWindow) deliverNativeFileDrag(active bool) {
+	w.updateNativeFileDrag(active, false)
+}
+
+// ResetNativeFileDrag retires queued native hints without reading OS drag data
+// or waiting on the native UI thread. Actual drop permission is unchanged.
+func (w *WebviewWindow) ResetNativeFileDrag() {
+	w.updateNativeFileDrag(false, true)
+}
+
+func (w *WebviewWindow) updateNativeFileDrag(active, reset bool) {
+	if w == nil || w.isDestroyed() || w.options.NativeFileDropHandler == nil || w.options.NativeFileDragHandler == nil {
+		return
+	}
+	w.nativeFileDragMu.Lock()
+	if w.nativeFileDragSerial >= whatsUpNativeDragLastSerial || !reset && w.nativeFileDragActive == active {
+		w.nativeFileDragMu.Unlock()
+		return
+	}
+	w.nativeFileDragSerial++
+	if w.nativeFileDragSerial == whatsUpNativeDragLastSerial {
+		active = false
+	}
+	w.nativeFileDragActive = active
+	serial := w.nativeFileDragSerial
+	w.nativeFileDragMu.Unlock()
+	w.options.NativeFileDragHandler(active, serial)
+}
