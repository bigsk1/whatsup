+		_ = stream.Close()
+		stream.Release()
+		return err
+	}
+	stream.Release() // The response/browser owns the native references now.
+	select {
+	case <-stream.Done():
+		return stream.Err()
+	case <-ctx.Done():
+		complete := stream.Exhausted()
+		_ = stream.Close()
+		if complete {
