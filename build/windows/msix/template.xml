<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="whatsup.exe"
        Arguments=""
        InstallLocation="C:\Program Files\\WhatsUp">
    </Installer>
    <PackageInformation
        PackageName="WhatsUp"
        PackageDisplayName="WhatsUp"
        PublisherName="CN="
        PublisherDisplayName=""
        Version="0.0.13.0"
        PackageDescription="Private one-to-one desktop messenger">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="local.whatsup.desktop"
                Description="Private one-to-one desktop messenger"
                DisplayName="WhatsUp"
                ExecutableName="whatsup.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>WhatsUp</DisplayName>
            <PublisherDisplayName></PublisherDisplayName>
            <Description>Private one-to-one desktop messenger</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="whatsup.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
